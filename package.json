{
	"name": "rise-landing-pages",
  "version": "1.1.82",
	"private": true,
	"description": "Native WordPress editor for Rise Landing Pages.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"package": "python3 scripts/package.py",
		"test:updater": "php tests/updater.php",
		"build": "wp-scripts build assets/editor.js assets/smooth-scroll.js --output-path=build",
		"start": "wp-scripts start assets/editor.js --output-path=build",
		"lint:js": "wp-scripts lint-js assets",
		"lint:css": "wp-scripts lint-style assets/*.css",
		"format": "wp-scripts format assets/editor.js assets/editor assets/editor.css blocks"
	},
	"devDependencies": {
		"@wordpress/scripts": "30.24.0",
		"typescript": "5.3.3"
	},
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.0.0"
	},
	"dependencies": {
		"lenis": "1.3.26"
	}
}
